{
  "name": "autoresearch-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "MCP server for autoresearch technique discovery, experiment scaffolding, and autonomous optimization loops. Inspired by Andrej Karpathy's autoresearch. Includes AI skill for OpenCode, Claude Code, and pi.dev.",
  "license": "Apache-2.0",
  "author": "Shree Mulay",
  "homepage": "https://github.com/shreemulay/autoresearch-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreemulay/autoresearch-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/shreemulay/autoresearch-mcp/issues"
  },
  "keywords": [
    "mcp",
    "autoresearch",
    "karpathy",
    "model-context-protocol",
    "ai-agents",
    "experiment-tracking",
    "prompt-optimization",
    "hill-climbing",
    "ratchet",
    "autonomous-research",
    "skill",
    "opencode",
    "claude-code"
  ],
  "bin": {
    "autoresearch-mcp": "./src/index.ts"
  },
  "files": [
    "src/",
    "catalog/",
    "skills/",
    "scripts/",
    "LICENSE",
    "README.md",
    "NOTICE",
    "ACKNOWLEDGMENTS.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "lint": "bunx biome check src/ tests/",
    "typecheck": "bunx tsc --noEmit",
    "load-catalog": "bun run src/db/load-catalog.ts",
    "postinstall": "node scripts/install-skill.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
