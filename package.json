{
  "name": "autoresearch-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for autoresearch technique discovery, experiment scaffolding, and autonomous optimization loops",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "lint": "bunx biome check src/",
    "typecheck": "bunx tsc --noEmit",
    "load-catalog": "bun run src/db/load-catalog.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
