					"description": "Optional status filter"
				},
				"project": {
					"type": "string",
					"description": "Optional project filter"
				},
				"limit": {
					"type": "integer",
					"minimum": 1,
					"maximum": 100,
					"default": 10,
					"description": "Maximum rows"
				}
			},
			"additionalProperties": false,
			"$schema": "http://json-schema.org/draft-07/schema#"
		},
		"execution": {
			"taskSupport": "forbidden"
		}
